<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="900" styleClass="game-screen" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="htl.steyr.tetris.controller.GameController">

    <!-- Hauptbereich -->
    <center>
        <StackPane>
            <HBox alignment="CENTER" spacing="30" styleClass="game-content">
                <padding><Insets bottom="20" left="0" right="20" top="20" /></padding>
                <VBox alignment="TOP_CENTER" minWidth="0" spacing="14" styleClass="board-column" HBox.hgrow="ALWAYS">
                    <Label styleClass="title-label" text="TETRIS" />
                    <Label styleClass="subtitle-label" text="CLASSIC MODE" />
                    <!-- Nimmt den restlichen Platz ein; das Spielfeld skaliert sich darin (siehe GameController) -->
                    <StackPane fx:id="boardHolder" alignment="TOP_CENTER" minHeight="0" minWidth="0" VBox.vgrow="ALWAYS">
                        <StackPane maxHeight="-Infinity" maxWidth="-Infinity">
                            <GridPane fx:id="gameField" focusTraversable="true" maxHeight="-Infinity" maxWidth="-Infinity" />
                            <!-- Liegt über dem Spielfeld und zeigt den Countdown bis zum Start. -->
                            <Label fx:id="countdownLabel" mouseTransparent="true" styleClass="countdown-label" text="3" />
                        </StackPane>
                    </StackPane>
                </VBox>

                <VBox alignment="TOP_LEFT" maxWidth="210" minWidth="210" prefWidth="210" spacing="14" styleClass="info-panel">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="sidebar-caption" text="GAME STATUS" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="closeButton" focusTraversable="false" onAction="#onCloseButtonClicked" styleClass="icon-button" text="×" />
                    </HBox>

                    <VBox spacing="3" styleClass="stat-card">
                        <Label styleClass="card-caption" text="SCORE" />
                        <Label fx:id="scoreLabel" styleClass="score-label" text="000" />
                    </VBox>

                    <VBox spacing="8" styleClass="stat-card">
                        <Label styleClass="card-caption" text="NEXT PIECE" />
                        <Pane fx:id="nextPane" prefHeight="78.0" prefWidth="178.0" styleClass="preview-pane" />
                    </VBox>

                    <VBox spacing="8" styleClass="stat-card hold-card">
                        <Label styleClass="card-caption" text="HOLD" />
                        <Pane fx:id="holdPane" prefHeight="110.0" prefWidth="178.0" styleClass="preview-pane" />
                    </VBox>

                    <HBox fillHeight="true" spacing="10" styleClass="stats-row">
                        <VBox spacing="3" styleClass="small-stat-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-caption" text="LINES" />
                            <Label fx:id="linesLabel" styleClass="coin-label" text="00" />
                        </VBox>
                        <VBox spacing="3" styleClass="small-stat-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-caption" text="LEVEL" />
                            <Label fx:id="levelLabel" styleClass="level-label" text="01" />
                        </VBox>
                    </HBox>

                    <VBox spacing="3" styleClass="stat-card">
                        <Label styleClass="card-caption" text="PAUSES LEFT" />
                        <Label fx:id="pauseLabel" styleClass="coin-label" text="3" />
                    </VBox>

                    <VBox spacing="3" styleClass="stat-card">
                        <Label styleClass="card-caption" text="ELAPSED TIME" />
                        <TextField fx:id="elapsedTimeField" editable="false" focusTraversable="false" styleClass="coin-label" text="00:00" />
                    </VBox>

                    <Pane VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="10">
                        <Button fx:id="pauseButton" focusTraversable="false" onAction="#onPauseButtonClicked" prefWidth="82" styleClass="pause-button" text="⏸" />
                        <Button focusTraversable="false" onAction="#onCloseButtonClicked" prefWidth="82" styleClass="exit-button" text="EXIT" />
                    </HBox>
                </VBox>
            </HBox>

            <Label fx:id="infoLabel"
                   mouseTransparent="true"
                   wrapText="true"
                   maxWidth="220"
                   minHeight="-Infinity"
                   styleClass="info-box"
                   StackPane.alignment="TOP_RIGHT">
                <StackPane.margin>
                    <Insets top="20" right="230" />
                </StackPane.margin>
            </Label>
        </StackPane>
    </center>

</BorderPane>