<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="htl.steyr.tetris.controller.GameoverController"
            prefWidth="500" prefHeight="350">

    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label text="GAME OVER" style="-fx-font-size: 36px; -fx-font-weight: bold;"/>

            <VBox alignment="CENTER" spacing="10">
                <Label text="Punkte:" style="-fx-font-size: 20px;"/>
                <Label fx:id="scoreLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

                <Label text="Highscore:" style="-fx-font-size: 20px;"/>
                <Label fx:id="highscoreLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
            </VBox>

            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="retryButton" text="Nochmal spielen" prefWidth="150"/>
                <Button fx:id="menuButton" text="Zurück zum Menü" prefWidth="150"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
