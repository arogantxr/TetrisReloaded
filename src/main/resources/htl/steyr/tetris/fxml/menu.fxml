<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.StackPane?>
<BorderPane prefHeight="600" prefWidth="900" styleClass="menu-screen" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="htl.steyr.tetris.controller.MenuController">

    <!-- X Button oben rechts -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="menu-header">
            <padding>
                <Insets left="28" right="22" top="22" />
            </padding>
            <Label styleClass="brand-label" text="TETRIS" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="closeButton" onAction="#onClosedButtonClicked" prefHeight="35" prefWidth="35" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="exitButton" text="X" />
        </HBox>
    </top>

    <!-- Highscore links -->
    <left>
        <VBox alignment="TOP_LEFT" prefWidth="190" spacing="12" styleClass="highscore-panel">
            <padding>
                <Insets bottom="24" left="20" right="16" top="16" />
            </padding>
            <Label styleClass="sectionLabel" text="HIGHSCORE" />
            <Label styleClass="muted-label" text="Die besten Runs" />

            <ListView fx:id="highscoreList"
                      VBox.vgrow="ALWAYS"
                      styleClass="highscore-list"/>

            <Button text="View all Scores"
                    fx:id="viewAllScoresButton"
                    prefHeight="40"
                    maxWidth="Infinity"
                    styleClass="secondary-button"
                    onAction="#onViewAllScoresClicked"/>
        </VBox>
    </left>

    <!-- Mitte -->
    <center>
        <VBox alignment="CENTER" spacing="24" styleClass="menu-center">

            <Label fx:id="welcomeLabel" styleClass="welcome-label" text="Willkommen zurück, User!" />

            <VBox alignment="CENTER" spacing="14">

                <Button fx:id="playButton" onAction="#onPlayButtonClicked" prefHeight="58" prefWidth="230" styleClass="playButton" text="Spielen" />

                <Button fx:id="optionsButton" onAction="#onOptionsButtonClicked" prefHeight="45" prefWidth="230" styleClass="shopButton" text="Optionen" />

            </VBox>

        </VBox>
    </center>

    <!-- Werbebanner rechts -->
    <right>
        <VBox fx:id="bannerPanel" alignment="TOP_CENTER" prefWidth="170" spacing="12" styleClass="banner-panel">
            <padding>
                <Insets bottom="28" left="18" right="18" top="28" />
            </padding>
            <Label styleClass="banner-title" text="READY&#10;TO PLAY?" />
            <Label styleClass="banner-mark" text="◆" />
            <StackPane fx:id="logoContainer" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS">
                <ImageView fx:id="logoImageView" pickOnBounds="true" preserveRatio="true" />
            </StackPane>
            <Label styleClass="banner-copy" text="Build your best run&#10;and reach the top." />
        </VBox>
    </right>

</BorderPane>
